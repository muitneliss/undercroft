{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Connector",
  "definitions": {
    "Connector": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "undercroft.dev/v1"
        },
        "kind": {
          "type": "string",
          "const": "Connector"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "auth": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "none"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "bearer"
                },
                "token": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "const": "connection"
                        }
                      },
                      "required": [
                        "from"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "const": "env"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "from",
                        "name"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "grantRefusal": {
                  "type": "string",
                  "enum": [
                    "hubspot-missing-scopes"
                  ]
                }
              },
              "required": [
                "kind",
                "token"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "oauth2"
                },
                "tokenUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "rotatesRefreshToken": {
                  "default": false,
                  "type": "boolean"
                },
                "scopes": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "accountHeader": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "tokenUrl"
              ],
              "additionalProperties": false
            }
          ]
        },
        "defaults": {
          "default": {},
          "type": "object",
          "properties": {
            "headers": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "timeoutMs": {
              "default": 60000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "pagination": {
              "default": {
                "kind": "none"
              },
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "none"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "json-link"
                    },
                    "nextPath": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.[\\]-]*$"
                    }
                  },
                  "required": [
                    "kind",
                    "nextPath"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "page-number"
                    },
                    "param": {
                      "default": "page",
                      "type": "string"
                    },
                    "startAt": {
                      "default": 1,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "stopOn": {
                      "default": "empty-page",
                      "type": "string",
                      "enum": [
                        "empty-page",
                        "total-path"
                      ]
                    },
                    "totalPath": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.[\\]-]*$"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "cursor"
                    },
                    "cursorPath": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.[\\]-]*$"
                    },
                    "param": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "cursorPath",
                    "param"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "offset"
                    },
                    "param": {
                      "default": "offset",
                      "type": "string"
                    },
                    "limitParam": {
                      "default": "limit",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "rateLimit": {
              "default": {},
              "type": "object",
              "properties": {
                "minIntervalMs": {
                  "default": 0,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "requestsPerMinute": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "requestsPerDay": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            },
            "retry": {
              "default": {},
              "type": "object",
              "properties": {
                "attempts": {
                  "default": 5,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "on": {
                  "default": [
                    429,
                    500,
                    502,
                    503,
                    504
                  ],
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "backoff": {
                  "default": "exponential",
                  "type": "string",
                  "enum": [
                    "exponential",
                    "fixed"
                  ]
                },
                "baseMs": {
                  "default": 500,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxMs": {
                  "default": 30000,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "jitter": {
                  "default": "full",
                  "type": "string",
                  "enum": [
                    "full",
                    "none"
                  ]
                },
                "respectRetryAfter": {
                  "default": true,
                  "type": "boolean"
                },
                "maxRetryAfterMs": {
                  "default": 120000,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            },
            "guards": {
              "default": {},
              "type": "object",
              "properties": {
                "failOnEmpty": {
                  "default": true,
                  "type": "boolean"
                },
                "failOnExactCount": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxRecords": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            },
            "wholeReadBudget": {
              "type": "object",
              "properties": {
                "requestsPerDay": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "remainingHeader": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "requestsPerDay"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "entities": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "request": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "list"
                      },
                      "method": {
                        "default": "GET",
                        "type": "string",
                        "enum": [
                          "GET",
                          "POST"
                        ]
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "query": {
                        "default": {},
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "partitions": {
                        "minItems": 2,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "body": {},
                      "batchRead": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "bodyTemplate": {
                            "type": "string",
                            "enum": [
                              "hubspot-batch-read"
                            ]
                          },
                          "properties": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "required": [
                          "path",
                          "bodyTemplate",
                          "properties"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "kind",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "batch-from"
                      },
                      "entity": {
                        "type": "string",
                        "minLength": 1
                      },
                      "idPath": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.[\\]-]*$"
                      },
                      "chunkSize": {
                        "default": 100,
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "bodyTemplate": {
                        "type": "string",
                        "enum": [
                          "hubspot-batch-inputs"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "entity",
                      "idPath",
                      "path",
                      "bodyTemplate"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "envelopePath": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.[\\]-]*$"
              },
              "idPath": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.[\\]-]*$"
              },
              "updatedAtPath": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.[\\]-]*$"
              },
              "pagination": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "none"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "json-link"
                      },
                      "nextPath": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.[\\]-]*$"
                      }
                    },
                    "required": [
                      "kind",
                      "nextPath"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "page-number"
                      },
                      "param": {
                        "default": "page",
                        "type": "string"
                      },
                      "startAt": {
                        "default": 1,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "stopOn": {
                        "default": "empty-page",
                        "type": "string",
                        "enum": [
                          "empty-page",
                          "total-path"
                        ]
                      },
                      "totalPath": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.[\\]-]*$"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "cursor"
                      },
                      "cursorPath": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.[\\]-]*$"
                      },
                      "param": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "cursorPath",
                      "param"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "offset"
                      },
                      "param": {
                        "default": "offset",
                        "type": "string"
                      },
                      "limitParam": {
                        "default": "limit",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "incremental": {
                "type": "object",
                "properties": {
                  "strategy": {
                    "type": "string",
                    "enum": [
                      "query-param",
                      "client-filter",
                      "header"
                    ]
                  },
                  "param": {
                    "type": "string"
                  },
                  "header": {
                    "type": "string"
                  },
                  "sourcePath": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.[\\]-]*$"
                  },
                  "format": {
                    "default": "iso8601",
                    "type": "string",
                    "enum": [
                      "iso8601",
                      "epoch-millis",
                      "yyyy-mm-dd",
                      "ms-json-date"
                    ]
                  },
                  "send": {
                    "default": "verbatim",
                    "type": "string",
                    "enum": [
                      "verbatim",
                      "rfc3339-seconds"
                    ]
                  }
                },
                "required": [
                  "strategy",
                  "sourcePath"
                ],
                "additionalProperties": false
              },
              "rateLimit": {
                "type": "object",
                "properties": {
                  "minIntervalMs": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "requestsPerMinute": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "requestsPerDay": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              },
              "guards": {
                "type": "object",
                "properties": {
                  "failOnEmpty": {
                    "default": true,
                    "type": "boolean"
                  },
                  "failOnExactCount": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "maxRecords": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              },
              "readScope": {
                "type": "string",
                "minLength": 1
              },
              "removedWhen": {
                "type": "string",
                "enum": [
                  "absent",
                  "parent-removed"
                ]
              },
              "documents": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_$-]+(?:\\.[A-Za-z0-9_$-]+)*$"
                    },
                    "part": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "contentType": {
                      "type": "string",
                      "enum": [
                        "text/plain",
                        "text/html"
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "part",
                    "contentType"
                  ],
                  "additionalProperties": false
                }
              },
              "neverRead": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_*-]+$"
                }
              }
            },
            "required": [
              "name",
              "request",
              "idPath"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "id",
        "displayName",
        "baseUrl",
        "auth",
        "entities"
      ],
      "additionalProperties": false
    }
  }
}
