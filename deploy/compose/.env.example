# Copy to `.env` for local development. `.env` is gitignored.
#
# In Dokploy these become secrets in the project's environment. A variable set in
# the Dokploy UI is NOT automatically injected into containers -- each one must be
# referenced in the compose `environment:` block (as they are above) or supplied
# via `env_file`. An unmapped variable arrives as an empty string, and services
# fail in confusing ways rather than saying what is missing.
#
# Local values below are throwaway. Production values are generated per
# environment and never committed, never pasted into docs, never logged.

# --- Host ports ---------------------------------------------------------------
# Off the well-known numbers on purpose: dev machines usually already have
# something on 5432/8080/3000. Not published at all in Dokploy.
VCDO_PORT_MINIO=19000
VCDO_PORT_MINIO_CONSOLE=19001
VCDO_PORT_POSTGRES=15432
VCDO_PORT_KESTRA=18080
VCDO_PORT_METABASE=13000

# --- Object storage (MinIO) ---------------------------------------------------
VCDO_S3_ENDPOINT=http://localhost:19000
VCDO_S3_ACCESS_KEY=vcdo-local
VCDO_S3_SECRET_KEY=vcdo-local-secret-change-me
VCDO_S3_REGION=us-east-1
VCDO_S3_BUCKET_RAW=vcc-raw
VCDO_S3_BUCKET_QUARANTINE=vcc-quarantine

# --- Curated store (Postgres) -------------------------------------------------
VCDO_PG_USER=vcdo
VCDO_PG_PASSWORD=vcdo-local-change-me
VCDO_PG_DB=vcdo
VCDO_POSTGRES_DSN=postgresql://vcdo:vcdo-local-change-me@localhost:15432/vcdo

# --- Service application databases --------------------------------------------
VCDO_KESTRA_PG_PASSWORD=kestra-local-change-me
VCDO_METABASE_PG_PASSWORD=metabase-local-change-me

# --- Metabase -----------------------------------------------------------------
# `vcdo provision-bi` is idempotent and is how the BI connection is recreated
# after a restore. Clicking through the UI once is not a deployment.
VCDO_METABASE_URL=http://localhost:13000
VCDO_METABASE_ADMIN_EMAIL=admin@vietcham.local
VCDO_METABASE_ADMIN_PASSWORD=VcdoLocal2026!
# Host as seen FROM the Metabase container, i.e. the compose service name.
VCDO_METABASE_PG_HOST=postgres

# --- BI identity --------------------------------------------------------------
# Metabase connects as metabase_ro: read-only, curated + ops only, explicitly
# NOT dq.quarantine (those rows carry raw source payloads). The role is created
# by migration 002; this password is applied by `vcdo migrate`.
VCDO_METABASE_RO_PASSWORD=metabase-ro-local-change-me

# --- Kestra access ------------------------------------------------------------
# Kestra 0.24+ REQUIRES auth; there is no anonymous mode. Set these explicitly
# rather than relying on a default: an orchestrator that can trigger every
# pipeline is not something to leave on shipped credentials.
#
# GOTCHA, measured 2026-09-17: Kestra silently rejects a password that fails
# its complexity rules. It does not log the rejection and it does not fail to
# start -- it simply 401s every request, including with the exact credentials
# you configured, which looks identical to a wrong key path. Use upper + lower
# + digit (their own example is `Admin1234`).
#
# Credentials are persisted into Kestra's metadata DB on first boot, so
# changing them afterwards needs the DB reset, not just an env change.
VCDO_KESTRA_USER=admin@vietcham.local
VCDO_KESTRA_PASSWORD=KestraLocal2026!

# --- Source mode --------------------------------------------------------------
# `mock` serves recorded fixtures; `live` calls the real API. The code path is
# identical, so onboarding a source is an env change plus a credential.
#
# Per-source overrides win over the global default, letting one source go live
# while the rest stay mocked:
#   VCDO_HUBSPOT_MODE=live
#   VCDO_XERO_MODE=mock
VCDO_SOURCE_MODE=mock
VCDO_FIXTURES_DIR=fixtures
VCDO_LOG_DIR=data/logs

# --- Source credentials -------------------------------------------------------
# Placeholders. Required ONLY for a source set to `live` -- config refuses to
# start a live source without one, rather than failing on the first API call
# after a partial run has already written state.
#
# Leave these empty in Dokploy until the corresponding source is ready to go
# live. An empty value with the source in `mock` mode is correct, not broken.
VCDO_HUBSPOT_CREDENTIALS=
VCDO_XERO_CREDENTIALS=
VCDO_GMAIL_CREDENTIALS=
VCDO_DRIVE_CREDENTIALS=
