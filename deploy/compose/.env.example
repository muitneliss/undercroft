# Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
# Generate the two secret keys with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Object store (MinIO) -----------------------------------------------------
UNDERCROFT_S3_ACCESS_KEY=undercroft
UNDERCROFT_S3_SECRET_KEY=change-me-minio-secret
UNDERCROFT_S3_BUCKET_RAW=undercroft-raw

# Postgres -----------------------------------------------------------------
UNDERCROFT_PG_USER=undercroft
UNDERCROFT_PG_PASSWORD=change-me-postgres
UNDERCROFT_PG_DB=undercroft
# dbt connects as `undercroft_dbt`, never as the platform role above — that separation is
# what makes it safe to run SQL a user wrote (ADR 0005). Without this, the transform verb
# fails inside dbt, far from anything that names the variable.
UNDERCROFT_DBT_PASSWORD=change-me-dbt

# Metabase -----------------------------------------------------------------
# Only the server variant uses this: there, Metabase has its own database rather than
# sharing the platform's.
UNDERCROFT_METABASE_PG_PASSWORD=change-me-metabase-pg

# Kestra -------------------------------------------------------------------
UNDERCROFT_KESTRA_USER=admin@example.com
UNDERCROFT_KESTRA_PASSWORD=change-me-kestra
UNDERCROFT_KESTRA_PG_PASSWORD=change-me-kestra-pg

# Secrets ------------------------------------------------------------------
# 32 bytes, base64. Rotate additively: "1:<old>,2:<new>".
UNDERCROFT_SECRET_KEY=change-me-32-byte-base64-key
# Signs session cookies. Generate like UNDERCROFT_SECRET_KEY (32 bytes, base64); changing it
# ends every signed-in session at once, which is also how you evict everyone in a hurry.
UNDERCROFT_SESSION_SECRET=change-me-session-signing-secret
# The token Kestra and the control plane present to the worker's verb allowlist.
UNDERCROFT_TRIGGER_TOKEN=change-me-trigger-token

# Sign-in ------------------------------------------------------------------
# Leave any of these unset and the control plane starts with NO way to sign in; it logs
# `sign_in_unconfigured` once at boot naming what is missing. Sign-in is invite-only in
# every case: an address must match a row in app.invitation or an existing app.app_user.
#
# The URL the BROWSER uses, not a container name — Better Auth builds Google's redirect_uri
# from it. Register <this>/api/auth/callback/google in the Google client.
UNDERCROFT_PUBLIC_URL=http://localhost:13000
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
# Identity scopes only (openid/email/profile). Do NOT add Gmail or Drive scopes here:
# ingestion credentials are a separate per-tenant consent, sealed in app.connection_secret.
UNDERCROFT_GOOGLE_CLIENT_ID=
UNDERCROFT_GOOGLE_CLIENT_SECRET=
# Delivers the one-time sign-in code. Without these, Google is the only way in.
UNDERCROFT_EMAIL_API_KEY=
UNDERCROFT_EMAIL_FROM=Undercroft <no-reply@example.test>
# Any provider taking { from, to, subject, text }. Defaults to Resend's endpoint when unset.
UNDERCROFT_EMAIL_API_URL=

# Platform administrators ---------------------------------------------------
# A comma-separated list of addresses that may sign in with NO invitation and that hold
# admin in every tenant. This is how a fresh deployment gets its first person in, and how
# you get back in after losing access — no shell, no SQL.
#
# THIS VARIABLE IS THE AUTHORITY. Nothing in the database records who is a superadmin, so
# removing an address here and redeploying withdraws it at the next request, and adding one
# grants it. There is nothing to drift.
#
# They still have to prove they control the address, through Google or a one-time code. And
# they are logged as themselves: `tenants.create` writes an audit row naming the address.
# Leave it empty on an install that manages access by invitation alone. ADR 0013.
UNDERCROFT_SUPERADMINS=

# Deploy pointer (server variant only) -------------------------------------
# Which published image the server runs. `latest` is the current release; set an explicit
# vX.Y.Z in Dokploy's environment to roll back. Unused by the development file, which
# builds from this checkout.
IMAGE_TAG=latest

# Host port bindings (all bound to 127.0.0.1) ------------------------------
UNDERCROFT_PORT_MINIO=19000
UNDERCROFT_PORT_MINIO_CONSOLE=19001
UNDERCROFT_PORT_POSTGRES=15432
UNDERCROFT_PORT_KESTRA=18080
UNDERCROFT_PORT_API=13000
UNDERCROFT_PORT_METABASE=13001
