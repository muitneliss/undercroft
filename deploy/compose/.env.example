# Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
# Generate the two secret keys with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Object store (MinIO) -----------------------------------------------------
UNDERCROFT_S3_ACCESS_KEY=undercroft
UNDERCROFT_S3_SECRET_KEY=change-me-minio-secret
UNDERCROFT_S3_BUCKET_RAW=undercroft-raw

# Postgres -----------------------------------------------------------------
UNDERCROFT_PG_USER=undercroft
UNDERCROFT_PG_PASSWORD=change-me-postgres
UNDERCROFT_PG_DB=undercroft
# The two platform roles' own passwords. `db-migrate` sets them on `undercroft_app` and
# `undercroft_worker`; the control plane and the worker then connect as themselves, never as
# the bootstrap superuser above -- which is the only way the grant model in
# packages/db/sql binds to anything. Generate like the secret keys below.
UNDERCROFT_APP_PG_PASSWORD=change-me-app-pg
UNDERCROFT_WORKER_PG_PASSWORD=change-me-worker-pg
# dbt has no password of its own any more: each build runs as the tenant's own login, whose
# password the worker mints right before and hands to the child by environment (ADR 0018).
# Nor does BI: the Reports division reads as each tenant's own read-only login the same
# way, and Metabase has left the stack (ADR 0020).

# Kestra -------------------------------------------------------------------
UNDERCROFT_KESTRA_USER=admin@example.com
UNDERCROFT_KESTRA_PASSWORD=change-me-kestra
UNDERCROFT_KESTRA_PG_PASSWORD=change-me-kestra-pg

# Secrets ------------------------------------------------------------------
# 32 bytes, base64. Rotate additively: "1:<old>,2:<new>".
UNDERCROFT_SECRET_KEY=change-me-32-byte-base64-key
# Signs session cookies. Generate like UNDERCROFT_SECRET_KEY (32 bytes, base64); changing it
# ends every signed-in session at once, which is also how you evict everyone in a hurry.
UNDERCROFT_SESSION_SECRET=change-me-session-signing-secret
# The token Kestra and the control plane present to the worker's verb allowlist.
UNDERCROFT_TRIGGER_TOKEN=change-me-trigger-token

# Sign-in ------------------------------------------------------------------
# Leave any of these unset and the control plane starts with NO way to sign in; it logs
# `sign_in_unconfigured` once at boot naming what is missing. Sign-in is invite-only in
# every case: an address must match a row in app.invitation or an existing app.app_user.
#
# The URL the BROWSER uses, not a container name — Better Auth builds Google's redirect_uri
# from it. Register <this>/api/auth/callback/google in the Google client.
UNDERCROFT_PUBLIC_URL=http://localhost:13000
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
# Identity scopes only (openid/email/profile). Do NOT add Gmail or Drive scopes here:
# ingestion credentials are a separate per-tenant consent, sealed in app.connection_secret.
# Per-tenant Gmail and Drive INGESTION. A second Google client, not the sign-in one below.
# Do NOT put Gmail or Drive scopes on the sign-in client; do not put identity-only scopes
# here. Keeping them apart is what stops signing in from handing over a mailbox.
# gmail.readonly is a Google "restricted" scope and needs verification plus an annual CASA
# assessment; drive.file is not, which is why Drive uses it. See docs/adr/0016.
UNDERCROFT_GOOGLE_INGEST_CLIENT_ID=
UNDERCROFT_GOOGLE_INGEST_CLIENT_SECRET=
# Milliseconds between two Gmail/Drive requests. Empty paces three a second, inside the
# 2-4 messages.get/second/user Google actually enforces -- a sixth of its published rate,
# and the reason a 7,777-message backfill died 378 messages in with "Quota exceeded for
# quota metric 'Total Query Cost'". Set it only for a project whose enforced quota differs;
# a value that is not a positive whole number fails the run rather than quietly pacing at
# the rate that caused the outage.
UNDERCROFT_GOOGLE_MIN_INTERVAL_MS=
# Public values for Drive's browser Picker. They identify the app and authorise nothing.
UNDERCROFT_GOOGLE_PICKER_API_KEY=
UNDERCROFT_GOOGLE_PROJECT_NUMBER=
# Per-tenant Xero ingestion: an OAuth 2.0 app at developer.xero.com with
# <UNDERCROFT_PUBLIC_URL>/oauth/xero/callback as its redirect URI. The control plane runs
# the consent with it; the worker refreshes and revokes with it. See docs/runbook/xero-setup.md.
UNDERCROFT_XERO_CLIENT_ID=
UNDERCROFT_XERO_CLIENT_SECRET=

UNDERCROFT_GOOGLE_CLIENT_ID=
UNDERCROFT_GOOGLE_CLIENT_SECRET=
# Delivers the one-time sign-in code. Without these, Google is the only way in.
UNDERCROFT_EMAIL_API_KEY=
UNDERCROFT_EMAIL_FROM=Undercroft <no-reply@example.test>
# Any provider taking { from, to, subject, text }. Defaults to Resend's endpoint when unset.
UNDERCROFT_EMAIL_API_URL=
# The operators' Lark group, for sync status: a failure, and the success that ends it. A custom
# bot's webhook URL -- it is the credential -- and its signing secret when signing is on.
# Unset means failures are emailed to a tenant's admins only.
UNDERCROFT_LARK_WEBHOOK_URL=
UNDERCROFT_LARK_WEBHOOK_SECRET=

# Platform administrators ---------------------------------------------------
# A comma-separated list of addresses that may sign in with NO invitation and that hold
# admin in every tenant. This is how a fresh deployment gets its first person in, and how
# you get back in after losing access — no shell, no SQL.
#
# THIS VARIABLE IS THE AUTHORITY. Nothing in the database records who is a superadmin, so
# removing an address here and redeploying withdraws it at the next request, and adding one
# grants it. There is nothing to drift.
#
# They still have to prove they control the address, through Google or a one-time code. And
# they are logged as themselves: `tenants.create` writes an audit row naming the address.
# Leave it empty on an install that manages access by invitation alone. ADR 0013.
UNDERCROFT_SUPERADMINS=

# Deploy pointer (server variant only) -------------------------------------
# Which published image the server runs. `latest` is the current release; set an explicit
# vX.Y.Z in Dokploy's environment to roll back. Unused by the development file, which
# builds from this checkout.
IMAGE_TAG=latest

# Host port bindings (all bound to 127.0.0.1) ------------------------------
UNDERCROFT_PORT_MINIO=19000
UNDERCROFT_PORT_MINIO_CONSOLE=19001
UNDERCROFT_PORT_POSTGRES=15432
UNDERCROFT_PORT_KESTRA=18080
UNDERCROFT_PORT_API=13000

# --- the assistant (ADR 0029) ------------------------------------------------------------
# Names only. Put the real values here in your own untracked `.env`; this file is tracked,
# and `.claude/rules/pii.md` is absolute about a credential never entering git.
#
# Two steps of degradation rather than one. With no model key the interleaf says it is
# unavailable and nothing else changes. With a model key and NO TypeSafe key the assistant
# answers questions and refuses to offer any change, because the prompt-injection gate fails
# closed -- an assistant that reads a customer's mail must not be talked into acting by it.
UNDERCROFT_ANTHROPIC_API_KEY=
UNDERCROFT_TYPESAFE_API_KEY=
# `openssl rand -base64 32`. Signs each approval request against the tool name, call id and
# arguments, so a tampered body cannot approve a call that was never offered.
UNDERCROFT_ASSISTANT_APPROVAL_SECRET=
# Defaults to claude-opus-5. Set only to pin a different model.
UNDERCROFT_ASSISTANT_MODEL=
