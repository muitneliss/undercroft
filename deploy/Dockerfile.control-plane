# The control plane: tRPC + OAuth + (built) SPA. A second public surface beside the
# worker, deliberately separate so ingestion keeps running with it stopped (ADR 0004).
FROM oven/bun:1.4.2-slim

WORKDIR /app

COPY package.json bun.lock ./
COPY packages ./packages
COPY apps ./apps
RUN bun install --frozen-lockfile --production

EXPOSE 3000

CMD ["bun", "run", "apps/control-plane/src/main.ts"]
