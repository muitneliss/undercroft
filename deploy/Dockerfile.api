# The control plane: the surface customers connect their accounts through.
#
# A separate image from the worker, and deliberately so. This one faces the
# internet through a Dokploy domain; the worker holds the pipeline lock and
# publishes no port at all. Merging them would put a public web server in the
# process that runs multi-minute syncs. See ADR 0004.
#
# It carries no postgresql-client and no fixtures: it configures runs, it does
# not perform them.

# --- stage 1: build the SPA --------------------------------------------------
#
# Bun, pinned to the version in ui/.bun-version, which is also what CI installs.
# A floating tag would let an upstream release change what the build produces
# without a commit in this repo.
FROM oven/bun:1.4.2-alpine AS ui

WORKDIR /ui

# Manifest before source, so a component change does not re-resolve the whole
# dependency tree on every rebuild.
COPY ui/package.json ui/bun.lock ./
RUN bun install --frozen-lockfile

COPY ui/ ./
# `bun run build` is `tsc --noEmit && vite build`. The typecheck is part of the
# image build on purpose: a type error should fail here rather than ship a
# bundle that throws in a browser.
RUN bun run build

# --- stage 2: the runtime ----------------------------------------------------
FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    VCDO_UI_DIST=/app/ui/dist

COPY requirements-dev.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements-dev.txt

COPY vcdo/ ./vcdo/
# Migrations come along because `vcdo migrate` is how the control plane's own
# schema arrives. Flows and fixtures do not: this image runs no pipeline.
COPY migrations/ ./migrations/
RUN pip install --no-cache-dir -e .

COPY --from=ui /ui/dist ./ui/dist

# Non-root. This process holds the session cookies and the master key that opens
# every customer's OAuth credential; there is no argument for root here.
RUN useradd --create-home --uid 10002 vcdoapi \
    && chown -R vcdoapi:vcdoapi /app
USER vcdoapi

EXPOSE 8000

# Deliberately shallow: it reports that this process is serving. It does NOT
# check Postgres, because a healthcheck that fails when a dependency blips gets
# the container restarted, which fixes nothing and drops in-flight requests.
# `vcdo doctor`, in the worker, is the deep check.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"

# One worker process. The work here is IO-bound and small; the reason not to
# scale up is that `uvicorn --workers` forks, and each fork would hold its own
# database pool against a Postgres shared with Kestra and Metabase on a host
# with 11 GiB and no swap.
CMD ["uvicorn", "vcdo.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
