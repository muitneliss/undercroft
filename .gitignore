node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Secrets. `pii.md` records the failure this section exists to prevent: blanket
# substring rules like `*secret*` silently swallowed the secrets module and its
# ADR. Everything here names a path, not a word -- run `git check-ignore -v` on
# anything new before trusting it.
.env
.env.*
!.env.example
deploy/compose/.env
# Local Dokploy CLI state. `.dokploy.json` holds the panel api_key and password;
# `.dokploy-env.json` is a dump of the whole environment blob, so it carries every
# live credential the stack runs on. Named here because they sit at the repo root,
# where `git add -A` would otherwise publish them on the first careless commit.
.dokploy.json
.dokploy-env.json

# Real data never enters git.
data/
fixtures/live/

# Local agent/tool scratch space, not part of the project.
.kanna/

# A developer's personal agent skill: it posts to their own Lark group, and its config.json
# holds that group's webhook URL, which IS the credential (`packages/core/src/lark.ts`).
# The `.agents/` symlink is Codex's pointer to it, ignored with it so
# `scripts/agentConfig.test.ts` still sees the two sides agree on a checkout that has it.
.claude/skills/lark-notify/
.agents/skills/lark-notify

# Feature-branch worktrees (`git worktree add .worktrees/<name>`). Each one is a second
# checkout of this same repo, so leaving it unignored does more than dirty `git status`:
# Biome reads this file (`vcs.useIgnoreFile` in `biome.jsonc`) and without this line it
# descends into them, finds a nested root `biome.jsonc`, and fails the whole gate with
# "Found a nested root configuration". Prettier needs the same line in `.prettierignore`,
# which is the one file its CLI reads.
.worktrees/

.DS_Store
.bun/

# Task's own checksum/status cache, and the local dbt venv `task dev:worker` provisions
# (mirrors the versions pinned in deploy/Dockerfile.worker). Neither is portable or shared.
.task/
.dbt-venv/
