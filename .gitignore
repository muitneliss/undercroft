node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Secrets. `pii.md` records the failure this section exists to prevent: blanket
# substring rules like `*secret*` silently swallowed the secrets module and its
# ADR. Everything here names a path, not a word -- run `git check-ignore -v` on
# anything new before trusting it.
.env
.env.*
!.env.example
deploy/compose/.env
# Local Dokploy CLI state. `.dokploy.json` holds the panel api_key and password;
# `.dokploy-env.json` is a dump of the whole environment blob, so it carries every
# live credential the stack runs on. Named here because they sit at the repo root,
# where `git add -A` would otherwise publish them on the first careless commit.
.dokploy.json
.dokploy-env.json

# Real data never enters git.
data/
fixtures/live/

# Local agent/tool scratch space, not part of the project.
.kanna/

.DS_Store
.bun/

# Task's own checksum/status cache, and the local dbt venv `task dev:worker` provisions
# (mirrors the versions pinned in deploy/Dockerfile.worker). Neither is portable or shared.
.task/
.dbt-venv/
