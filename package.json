{
  "name": "undercroft",
  "version": "1.8.0",
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "yaml": "2.6.1"
  },
  "description": "An immutable raw lake with declarative connectors and user-defined transforms.",
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "lint": "biome lint --error-on-warnings .",
    "lint:rules": "ast-grep scan",
    "migrate": "bun run packages/db/src/migrateCli.ts",
    "invite": "bun run apps/control-plane/src/inviteCli.ts",
    "format": "biome format --write . && prettier --write .",
    "format:check": "biome format . && prettier --check .",
    "spec:validate": "bun run packages/contracts/scripts/validateSpecs.ts",
    "spec:schema": "bun run packages/contracts/scripts/emitSchema.ts",
    "build:ui": "bun run --filter '@undercroft/ui' build",
    "test": "bun test",
    "verify": "bun run typecheck && bun run lint && bun run lint:rules && bun run format:check && bun run spec:validate && bun run build:ui && bun run test",
    "wiki:check": "bun run scripts/wikiCoverage.ts"
  },
  "type": "module",
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
