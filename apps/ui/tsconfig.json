{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun", "@happy-dom/global-registrator"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*", "src/**/*.json"],
  "references": [{ "path": "../../packages/core" }, { "path": "../../packages/contracts" }]
}
