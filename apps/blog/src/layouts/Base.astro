---
/**
 * Every page's head and frame. The head is where search engines read the page, so it is
 * written once here: canonical, hreflang for each language plus x-default, Open Graph,
 * the RSS feed and any JSON-LD the page supplies. A page passes facts; it never writes tags.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import favicon from "../../../ui/public/favicon.svg?url";
import appleTouch from "../../../ui/public/apple-touch-icon.png?url";
import Mark from "../../../ui/public/mark.svg";
import cover from "../assets/cover.png";
import { CONTACT_EMAIL, DEFAULT_LANG, type Lang, PRODUCT_URL, REPO_URL, STRINGS, langPrefix } from "../site.ts";
import type { JsonLd } from "../structuredData.ts";
import "../styles/blog.css";

interface Alternate {
  lang: Lang;
  path: string;
}

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates: Alternate[];
  image?: ImageMetadata;
  imageAlt?: string;
  article?: { published: Date; modified: Date; tags: string[] };
  jsonLd?: JsonLd[];
  /** For pages that must never be a search result, such as the 404. */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  path,
  alternates,
  image,
  imageAlt,
  article,
  jsonLd = [],
  noindex = false,
} = Astro.props;
const s = STRINGS[lang];
const site = Astro.site ?? new URL("https://blog.undercroft.lowbit.link");
const canonical = new URL(path, site).href;
const og = await getImage({ src: image ?? cover, width: 1200, height: 630, format: "jpeg", fit: "cover" });
const ogUrl = new URL(og.src, site).href;
const xDefault = alternates.find((alt) => alt.lang === DEFAULT_LANG);
const other = alternates.find((alt) => alt.lang !== lang);
const home = `${langPrefix(lang)}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#efe9d9" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleTouch} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${s.siteTitle} (${s.rss})`} href={`${home}rss.xml`} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={new URL(alt.path, site).href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.path, site).href} />}

    <meta property="og:site_name" content="Undercroft" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? title} />
    <meta property="og:locale" content={s.ogLocale} />
    {other && <meta property="og:locale:alternate" content={STRINGS[other.lang].ogLocale} />}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:modified_time" content={article.modified.toISOString()} />
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="runhead">
      <a class="brand" href={home} aria-label={s.home}>
        <Mark class="brand__mark" fill="currentColor" aria-hidden="true" />
        <span class="brand__word">Undercroft</span>
        <span class="brand__kicker">{s.kicker}</span>
      </a>
      <nav class="runhead__nav" aria-label="Undercroft">
        <a href={PRODUCT_URL}>{s.tryProduct}</a>
        <a href={REPO_URL}>GitHub</a>
        {other && <a href={other.path} hreflang={other.lang} lang={other.lang}>{s.otherLanguage}</a>}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="colophon">
      <span>{s.footer}</span>
      <a class="colophon__mail" href={`mailto:${CONTACT_EMAIL}`} aria-label={s.contact}>{CONTACT_EMAIL}</a>
      <a href={`${home}rss.xml`}>{s.rss}</a>
      <a href={REPO_URL}>GitHub</a>
    </footer>
  </body>
</html>
